# 문서용 예시. 자동 로딩되지 않습니다. 실제 비밀 값을 기록하지 마세요.
# runner 구현 시 로딩 우선순위를 확정합니다. 현재 qa:check는 process.env만 읽습니다.
E2E_PORT=3100
# 지정하면 로컬 build/start를 생략하는 계약입니다. origin만 허용합니다.
# PLAYWRIGHT_BASE_URL=https://preview.example.com
# 아래 주소는 로컬 테스트 빌드 제안값이며 앱 URL 결합·SSE는 후속 검증 대상입니다.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3100/__qa_api
NEXT_PUBLIC_AI_API_BASE_URL=http://127.0.0.1:3100/__qa_ai
