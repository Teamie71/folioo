{
  "name": "@folioo/bud-icons",
  "version": "0.1.0",
  "description": "Bud React icon components",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean:generated": "node scripts/clean-generated.mjs",
    "generate": "pnpm run clean:generated && svgr --config-file .svgrrc.json --out-dir src/icons -- svg",
    "build": "pnpm run generate && tsup",
    "check-types": "pnpm run generate && tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@svgr/cli": "8.1.0",
    "@types/react": "^19.3.0",
    "react": "19.3.1",
    "tsup": "8.5.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
