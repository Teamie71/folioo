{
  "name": "@folioo/bud-icons",
  "version": "0.1.0",
  "description": "Bud React icon components",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "svgr --config-file .svgrrc.json --out-dir src/generated -- svg",
    "build": "tsup",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@svgr/cli": "8.1.0",
    "@types/react": "^19.3.0",
    "react": "19.3.1",
    "tsup": "8.5.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
