{
  "name": "@folioo/bud-tokens",
  "version": "0.0.1",
  "description": "Bud design tokens (Folioo design system) built with vanilla-extract",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/generate-tokens.mjs && tsup",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@vanilla-extract/css": "1.17.4",
    "@vanilla-extract/esbuild-plugin": "2.3.19",
    "tsup": "8.5.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
