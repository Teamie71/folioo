{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "check-types": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@folioo/ai#lint": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["UV_CACHE_DIR", "UV_OFFLINE", "UV_PYTHON"]
    },
    "@folioo/ai#format:check": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["UV_CACHE_DIR", "UV_OFFLINE", "UV_PYTHON"]
    },
    "@folioo/ai#test": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "EXPMAP_TEST_DATABASE_URL",
        "EXPMAP_REQUIRE_DB",
        "OPENROUTER_API_KEY",
        "UV_CACHE_DIR",
        "UV_OFFLINE",
        "UV_PYTHON"
      ]
    },
    "@folioo/ai#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    }
  }
}
