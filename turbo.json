{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "check-types": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@folioo/web#check-types": {
      "dependsOn": ["^build"],
      "outputs": ["next-env.d.ts", ".next/types/**"]
    },
    "@folioo/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "next-env.d.ts"]
    },
    "@folioo/bud-icons#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/icons/**"]
    },
    "@folioo/bud-icons#check-types": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@folioo/ai#lint": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["UV_CACHE_DIR", "UV_OFFLINE", "UV_PYTHON"]
    },
    "@folioo/ai#format:check": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["UV_CACHE_DIR", "UV_OFFLINE", "UV_PYTHON"]
    },
    "@folioo/ai#test": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "EXPMAP_TEST_DATABASE_URL",
        "EXPMAP_REQUIRE_DB",
        "OPENROUTER_API_KEY",
        "UV_CACHE_DIR",
        "UV_OFFLINE",
        "UV_PYTHON"
      ]
    }
  }
}
