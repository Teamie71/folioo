{
  "name": "folioo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "check-types": "turbo run check-types",
    "check": "pnpm format:check && pnpm lint && pnpm run web:lint && pnpm check-types && pnpm build",
    "check:all": "pnpm run check && pnpm run ai:check && pnpm run api:check",
    "web:dev": "turbo run dev --filter=@folioo/web",
    "web:lint": "pnpm --filter @folioo/web lint",
    "web:check-types": "turbo run check-types --filter=@folioo/web",
    "web:build": "turbo run build --filter=@folioo/web",
    "web:start": "pnpm --filter @folioo/web start",
    "web:check": "pnpm run web:lint && pnpm run web:check-types && pnpm run web:build",
    "ai:setup": "pnpm --filter @folioo/ai run setup",
    "ai:setup:local": "pnpm --filter @folioo/ai run setup:local",
    "ai:dev": "pnpm --filter @folioo/ai run serve",
    "ai:dev:external": "pnpm --filter @folioo/ai run serve:external",
    "ai:lint": "turbo run lint --filter=@folioo/ai",
    "ai:format": "pnpm --filter @folioo/ai run format",
    "ai:format:check": "turbo run format:check --filter=@folioo/ai",
    "ai:test": "EXPMAP_REQUIRE_DB=1 turbo run test --filter=@folioo/ai",
    "ai:check": "pnpm run ai:lint && pnpm run ai:format:check && pnpm run ai:test",
    "api:setup": "pnpm -C apps/server install --frozen-lockfile",
    "api:dev": "pnpm -C apps/server run start:dev",
    "api:build": "pnpm -C apps/server run build",
    "api:lint": "pnpm -C apps/server run lint",
    "api:format": "pnpm -C apps/server run format",
    "api:format:check": "pnpm -C apps/server run format:check",
    "api:test": "pnpm -C apps/server run test",
    "api:test:e2e": "pnpm -C apps/server run test:e2e",
    "api:check": "pnpm run api:lint && pnpm run api:format:check && pnpm run api:build && pnpm run api:test",
    "web:qa:plan": "pnpm --filter @folioo/web qa:plan",
    "web:qa:smoke": "pnpm --filter @folioo/web qa:smoke",
    "web:qa:full": "pnpm --filter @folioo/web qa:full"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
