{
  "name": "folioo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "check-types": "turbo run check-types",
    "check": "pnpm format:check && pnpm lint && pnpm check-types && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
