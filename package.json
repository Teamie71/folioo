{
  "name": "folioo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "check-types": "turbo run check-types",
    "check": "pnpm format:check && pnpm lint && pnpm check-types && pnpm build && pnpm run ai:lint && pnpm run ai:format:check",
    "check:all": "pnpm run check && pnpm run ai:test",
    "ai:setup": "pnpm --filter @folioo/ai run setup",
    "ai:setup:local": "pnpm --filter @folioo/ai run setup:local",
    "ai:dev": "pnpm --filter @folioo/ai run serve",
    "ai:lint": "turbo run lint --filter=@folioo/ai",
    "ai:format": "pnpm --filter @folioo/ai run format",
    "ai:format:check": "turbo run format:check --filter=@folioo/ai",
    "ai:test": "EXPMAP_REQUIRE_DB=1 turbo run test --filter=@folioo/ai",
    "ai:check": "pnpm run ai:lint && pnpm run ai:format:check && pnpm run ai:test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
